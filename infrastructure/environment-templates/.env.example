# =============================================================================
# Mizan — Example environment (development). Ref: CLAUDE.md §16.
# COMMIT THIS FILE. Never commit a real .env — secrets are git-ignored (§11 #14).
# Copy to `.env.development` at the repo root and fill in real values.
# =============================================================================

NODE_ENV=development
API_PORT=3000

# ---- Product / deployment identity ----
APP_NAME=Mizan
ORGANIZATION_CODE=DEMO

# ---- Data stores ----
DATABASE_URL=postgresql://mizan:CHANGEME@postgres:5432/mizan_inventory

# ---- Authentication / session (DESC §11.1 controls 3–7, 12) ----
JWT_SECRET=CHANGEME
JWT_REFRESH_SECRET=CHANGEME
MFA_ENABLED=false
# DESC #7 — 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored TOTP secrets.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Mizan
# Machine accounts that cannot type a code (the AI service). Exempt ONLY when signing in
# from these networks — keep it to this server. Use a dedicated account, never a person's.
MFA_EXEMPT_ACCOUNTS=ai-service@example.com
MFA_EXEMPT_NETWORKS=127.0.0.1/32,::1/128
SESSION_IDLE_TIMEOUT_MINUTES=30
ACCOUNT_LOCKOUT_ATTEMPTS=5

# DESC #12 — rate limiting on /auth/* (per client IP, per endpoint).
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Number of reverse-proxy hops in front of the API (1 behind nginx). Leave empty in dev.
TRUST_PROXY=

# DESC #15 — JSON logs via Pino; personal data is redacted (see security/log-hygiene).
LOG_LEVEL=info

# DESC #17 — encrypted backups (scripts/backup-database.sh). The key file is never in the repo.
BACKUP_DIRECTORY=/var/backups/mizan
BACKUP_ENCRYPTION_KEY_FILE=/etc/mizan/backup-encryption.key
BACKUP_RETENTION_DAYS=14

# ---- Email (on-premise SMTP relay — the only permitted outbound traffic) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mizan Inventory <inventory@example.com>"

# ---- Object storage ----
# ---- AI service ----
# Docker Compose values (when ai-service/ollama run as containers):
AI_SERVICE_URL=http://ai-service:8000
OLLAMA_URL=http://ollama:11434
# Native run on this Jetson (ai-service via uvicorn, Ollama as a systemd service) — override to:
# AI_SERVICE_URL=http://localhost:8000
# OLLAMA_URL=http://localhost:11434

# Language model — see §2.1. Switch the profile, never edit feature code.
LANGUAGE_MODEL_PROFILE=llama-development
# LANGUAGE_MODEL_PROFILE=qwen-production

# Service account the ai-service daily job / assistant use to call the backend internally.
# Must be an ADMIN account that exists in the target database (the seeded demo admin works).
# The AI service's own account — never a person's (OPEN-QUESTIONS #21). Created by the seed.
SERVICE_ACCOUNT_EMAIL=ai-service@example.com
SERVICE_ACCOUNT_PASSWORD=CHANGEME

# ---- Scheduling / locale ----
REPLENISHMENT_RUN_TIME=07:00
TZ=Asia/Dubai
DEFAULT_LANGUAGE=en
