# Frontend build-time env for a HOSTED build. Copy to .env.production only if you
# host the API on a DIFFERENT origin than the frontend (e.g. a tunnel, or a
# separate backend domain). Leave it UNSET when using Firebase Hosting with the
# /api rewrite to Cloud Run — there the frontend and API share one origin and the
# default relative "/api/v1" works.
#
# Local development ignores this file entirely; `npm run dev` keeps using the
# Vite proxy. Nothing here changes local behaviour.

# VITE_API_BASE_URL=https://your-backend-host.example/api/v1
